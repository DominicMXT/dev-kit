name: {{ project_slug | replace('_', '-') }}-prod

services:
  postgres:
    image: postgres:18-alpine
    container_name: {{ project_slug }}_postgres
    environment:
      POSTGRES_USER: ${POSTGRES_USER:?}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?}
      POSTGRES_DB: ${POSTGRES_DB:?}
    volumes:
      - postgres_data:/var/lib/postgresql
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 10s
      timeout: 5s
      retries: 5
{%- if use_redis %}

  redis:
    image: redis:7-alpine
    container_name: {{ project_slug }}_redis
    command: redis-server --requirepass ${REDIS_PASSWORD:?} --appendonly yes --appendfsync everysec
    volumes:
      - redis_data:/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "--no-auth-warning", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
{%- endif %}

  backend:
    build:
      context: ../backend
      dockerfile: ../docker/Dockerfile
    image: {{ project_slug | replace('_', '-') }}-backend:prod
    container_name: {{ project_slug }}_backend
    env_file: ../backend/.env
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
{%- if use_redis %}
      REDIS_HOST: redis
      REDIS_PORT: 6379
{%- endif %}
      RUN_MODE: prod
    ports:
      - "127.0.0.1:8000:8000"
    depends_on:
      postgres:
        condition: service_healthy
{%- if use_redis %}
      redis:
        condition: service_healthy
{%- endif %}
    volumes:
      - ../backend/migrations:/app/migrations
    restart: unless-stopped
{%- if use_worker %}

  worker:
    build:
      context: ../backend
      dockerfile: ../docker/Dockerfile
    image: {{ project_slug | replace('_', '-') }}-backend:prod
    command: ["taskiq", "worker", "app.tasks.broker:broker"]
    env_file: ../backend/.env
    environment:
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
      REDIS_HOST: redis
      REDIS_PORT: 6379
      RUN_MODE: prod
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped
{%- endif %}

volumes:
  postgres_data:
{%- if use_redis %}
  redis_data:
{%- endif %}
