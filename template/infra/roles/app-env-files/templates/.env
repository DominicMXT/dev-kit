{% for key, value in app_env.items() %}
{% if value is iterable and value is not string or value is mapping or value is boolean %}
{{ key }}={{ value | to_json(ensure_ascii=false) }}
{% else %}
{% if app_env_disable_interpolation and value is string and '$' in value %}
{{ key }}='{{ value }}'
{% else %}
{{ key }}={{ value }}
{% endif %}
{% endif %}
{% endfor %}
