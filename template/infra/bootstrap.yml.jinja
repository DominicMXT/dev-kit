- name: 'Bootstrap host (run once as root or a sudo user: -e ansible_user=<user>)'
  hosts: {{ project_slug }}
  pre_tasks:
  - name: Prerequisite for deb822_repository in role "os" (fresh Ubuntu lacks python3-debian)
    apt:
      name: python3-debian
      update_cache: true
      cache_valid_time: 3600
      install_recommends: false
    become: true

  - name: Remove duplicate Docker apt source (role docker writes docker.list)
    file:
      path: /etc/apt/sources.list.d/docker.sources
      state: absent
    become: true

  roles:
  - os
  - unix-users
  - docker
  - nginx
  - logrotate-env
  post_tasks:
  - name: Requirements for Ansible Docker modules
    apt:
      name: python3-docker
      install_recommends: false
    become: true

  - name: Init Docker Swarm
    community.docker.docker_swarm:
      state: present
    become: true
